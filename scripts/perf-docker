#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "${script_dir}/.." && pwd)
results_dir=${REVOMAN_PERF_RESULTS_DIR:-"${repo_root}/build/perf-results"}
image=revoman-perf:jdk21
uid=$(id -u)
gid=$(id -g)

mkdir -p "${results_dir}"
docker build \
  --tag "${image}" \
  - <"${repo_root}/Dockerfile.perf"

if (($# == 0)); then
  set -- \
    ./gradlew jmh \
    -Pjmh.smoke=true \
    -Pjmh.includes=RuntimeLifecycleBenchmark \
    -Pjmh.profilers=gc \
    -Pjmh.resultsFile=/results/smoke.json \
    -Pjmh.humanOutputFile=/results/smoke.txt
fi

docker run --rm \
  --user "${uid}:${gid}" \
  --env HOME=/perf-home \
  --env GRADLE_USER_HOME=/gradle-cache \
  --env REVOMAN_BANNER=off \
  --mount "type=bind,source=${repo_root},target=/workspace" \
  --mount "type=bind,source=${results_dir},target=/results" \
  --mount type=volume,source=revoman-perf-gradle,target=/gradle-cache \
  --workdir /workspace \
  "${image}" \
  "$@"
