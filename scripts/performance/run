ADAPTER_WATCHER_PID=''
ADAPTER_WATCHER_STARTED=0
ADAPTER_QUALIFICATION_ROOT=''

adapter_system_name() {
  /usr/bin/uname -s
}

adapter_process_status() {
  /bin/ps "$@"
}

