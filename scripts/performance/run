ADAPTER_RUNTIME_MANIFEST='sha256:6c7425db05efdcf0ba40d989898857b093f14ceaf9684c9c31a072c159f4590e'
ADAPTER_RUNTIME_CONFIG='sha256:ad6963934ee96838c09d99f3c4df6f991cd00ed70fa8a48f7045517d7ae8991c'
ADAPTER_JAVA_SHA256='1cedc51a4102638f1f06077acb3611b88f3061f9c7d76bd0a0df7f8607a9367b'
ADAPTER_PLATFORM='linux/arm64'
ADAPTER_CPUSET='0-3'
ADAPTER_MEMORY='6g'
