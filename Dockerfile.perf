FROM eclipse-temurin:21.0.11_10-jdk-noble

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir --parents /workspace /results /gradle-cache /perf-home \
    && chmod 1777 /gradle-cache /perf-home

ENV HOME=/perf-home \
    GRADLE_USER_HOME=/gradle-cache \
    REVOMAN_BANNER=off

WORKDIR /workspace
USER 65534:65534
