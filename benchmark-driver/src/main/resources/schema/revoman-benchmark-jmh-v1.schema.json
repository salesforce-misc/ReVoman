{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoman.dev/schema/revoman-benchmark-jmh-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resultId", "createdAt", "harness", "environment", "target", "workload", "configuration", "benchmarks"],
  "properties": {
    "schema": { "const": "revoman-benchmark-jmh/v1" },
    "resultId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "harness": { "$ref": "#/$defs/harness" },
    "environment": { "$ref": "#/$defs/environment" },
    "target": { "$ref": "#/$defs/target" },
    "workload": { "$ref": "#/$defs/workloadIdentity" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "benchmarks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/benchmark" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalId", "executionPath", "sizeBytes", "sha256"],
      "properties": {
        "logicalId": { "type": "string", "minLength": 1 },
        "executionPath": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "jdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "vendor", "fullVersion", "javaHome", "jvmFlags"],
      "properties": {
        "distribution": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "fullVersion": { "type": "string", "minLength": 1 },
        "javaHome": { "type": "string", "minLength": 1 },
        "jvmFlags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "dirty", "distributionSha256", "artifacts", "workloadContractSha256", "fixtureSetSha256", "adapters"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "distributionSha256": { "$ref": "#/$defs/sha256" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "workloadContractSha256": { "$ref": "#/$defs/sha256" },
        "fixtureSetSha256": { "$ref": "#/$defs/sha256" },
        "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jdk", "osName", "osVersion", "kernel", "cpuModel", "cpuCount", "governor", "physicalMemoryBytes", "hostFingerprintSha256"],
      "properties": {
        "jdk": { "$ref": "#/$defs/jdk" },
        "osName": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "cpuModel": { "type": "string", "minLength": 1 },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "governor": { "type": "string", "minLength": 1 },
        "physicalMemoryBytes": { "type": "integer", "minimum": 1 },
        "hostFingerprintSha256": { "$ref": "#/$defs/sha256" },
        "policySha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gitCommit", "gitTree", "dirty", "gradleVersion", "wrapperSha256", "buildJdk", "manifestSha256", "classpathSha256", "adapter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "minLength": 1 },
        "gitTree": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "gradleVersion": { "type": "string", "minLength": 1 },
        "wrapperSha256": { "$ref": "#/$defs/sha256" },
        "buildJdk": { "$ref": "#/$defs/jdk" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "classpathSha256": { "$ref": "#/$defs/sha256" },
        "adapter": { "$ref": "#/$defs/adapter" }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksum", "executedSteps", "failureCount"],
      "properties": {
        "checksum": { "type": "integer" },
        "executedSteps": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 }
      }
    },
    "workloadManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion", "files", "fixtureTreeSha256", "operationIds", "requiredGatesByMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "fixtureTreeSha256": { "$ref": "#/$defs/sha256" },
        "operationIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredGatesByMode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["COLD", "WARM", "RETAINED"],
          "properties": {
            "COLD": { "type": "array", "items": { "type": "string" } },
            "WARM": { "type": "array", "items": { "type": "string" } },
            "RETAINED": { "type": "array", "items": { "type": "string" } }
          }
        },
        "expectedDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "manifest"],
      "properties": {
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "manifest": { "$ref": "#/$defs/workloadManifest" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedIncludes", "requestedForks", "profilers", "internalProfilers", "quick", "logging"],
      "properties": {
        "requestedIncludes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requestedForks": { "type": "integer", "minimum": 1 },
        "profilers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "internalProfilers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "quick": { "type": "boolean" },
        "logging": { "$ref": "#/$defs/logging" }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log4j2ConfigurationFileSha256", "log4j2GlobalConfigurationFileSha256", "kotlinLoggingStartupMessage", "revomanBanner"],
      "properties": {
        "log4j2ConfigurationFileSha256": { "$ref": "#/$defs/sha256" },
        "log4j2GlobalConfigurationFileSha256": { "$ref": "#/$defs/sha256" },
        "kotlinLoggingStartupMessage": { "type": "string", "minLength": 1 },
        "revomanBanner": { "type": "string", "minLength": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "metric", "provider", "unit", "fork", "iteration", "processId", "value"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "metric": { "enum": ["LATENCY", "ALLOCATED_BYTES", "PEAK_RSS", "RETAINED_BYTES", "BYTES_PER_STEP"] },
        "provider": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["NANOSECONDS", "NANOSECONDS_PER_OPERATION", "BYTES", "BYTES_PER_EXECUTION", "BYTES_PER_OPERATION"] },
        "fork": { "type": "integer", "minimum": 0 },
        "iteration": { "type": "integer", "minimum": 0 },
        "replicateGroup": { "type": "null" },
        "processId": { "type": "integer", "minimum": 1 },
        "value": { "type": "number", "minimum": 0 },
        "retainedEvidence": { "type": "null" }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "buckets"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "buckets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bucket" } }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "provider", "providerConfigurationSha256", "unit"],
      "properties": {
        "metric": { "enum": ["LATENCY", "ALLOCATED_BYTES", "PEAK_RSS", "RETAINED_BYTES", "BYTES_PER_STEP"] },
        "provider": { "type": "string", "minLength": 1 },
        "providerConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "unit": { "enum": ["NANOSECONDS", "NANOSECONDS_PER_OPERATION", "BYTES", "BYTES_PER_EXECUTION", "BYTES_PER_OPERATION"] },
        "rawObservations": { "oneOf": [{ "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } }, { "type": "null" }] },
        "exactHistogram": { "oneOf": [{ "$ref": "#/$defs/histogram" }, { "type": "null" }] }
      },
      "oneOf": [
        { "required": ["rawObservations"], "properties": { "rawObservations": { "type": "array" }, "exactHistogram": { "type": "null" } } },
        { "required": ["exactHistogram"], "properties": { "rawObservations": { "type": "null" }, "exactHistogram": { "$ref": "#/$defs/histogram" } } }
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "jmhVersion", "mode", "threads", "forks", "jvm", "jvmArgs", "jdkVersion", "vmName", "vmVersion", "warmupIterations", "warmupTime", "warmupBatchSize", "measurementIterations", "measurementTime", "measurementBatchSize", "metricSeries"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
        "jmhVersion": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "threads": { "type": "integer", "minimum": 1 },
        "forks": { "type": "integer", "minimum": 1 },
        "jvm": { "type": "string", "minLength": 1 },
        "jvmArgs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "jdkVersion": { "type": "string", "minLength": 1 },
        "vmName": { "type": "string", "minLength": 1 },
        "vmVersion": { "type": "string", "minLength": 1 },
        "warmupIterations": { "type": "integer", "minimum": 0 },
        "warmupTime": { "type": "string", "minLength": 1 },
        "warmupBatchSize": { "type": "integer", "minimum": 1 },
        "measurementIterations": { "type": "integer", "minimum": 1 },
        "measurementTime": { "type": "string", "minLength": 1 },
        "measurementBatchSize": { "type": "integer", "minimum": 1 },
        "metricSeries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/series" } }
      }
    }
  }
}
