{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoman.dev/performance/protocol/schemas/campaign-v1.schema.json",
  "title": "ReVoman private campaign evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempts",
    "campaignId",
    "claimEligible",
    "implementation",
    "performanceSessionId",
    "qualification",
    "reason",
    "schemaVersion",
    "status",
    "strength"
  ],
  "properties": {
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "campaignId": {
      "$ref": "#/$defs/safeId"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "claimEligible": {
      "type": "boolean"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "performanceSessionId": {
      "$ref": "#/$defs/safeId"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "reason": {
      "enum": [
        "candidateMeasured",
        "calibrationExhausted"
      ]
    },
    "schemaVersion": {
      "const": "campaign-v1"
    },
    "selectedAttemptId": {
      "$ref": "#/$defs/safeId"
    },
    "status": {
      "enum": [
        "exhausted",
        "qualified"
      ]
    },
    "strength": {
      "enum": [
        "canonical",
        "diagnostic"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "candidate",
          "selectedAttemptId"
        ],
        "properties": {
          "claimEligible": {
            "const": true
          },
          "reason": {
            "const": "candidateMeasured"
          },
          "strength": {
            "const": "canonical"
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "candidate"
              ]
            },
            {
              "required": [
                "selectedAttemptId"
              ]
            }
          ]
        },
        "properties": {
          "claimEligible": {
            "const": false
          },
          "reason": {
            "const": "calibrationExhausted"
          },
          "strength": {
            "const": "diagnostic"
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleSha256",
        "captureId",
        "captureSha256",
        "path",
        "processRunId",
        "role",
        "sequence"
      ],
      "properties": {
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "captureId": {
          "$ref": "#/$defs/safeId"
        },
        "captureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "processRunId": {
          "$ref": "#/$defs/safeId"
        },
        "role": {
          "enum": [
            "A1",
            "A2",
            "B"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a1",
        "a2",
        "attemptId",
        "calibration",
        "forks",
        "receipts"
      ],
      "properties": {
        "a1": {
          "$ref": "#/$defs/artifactRef"
        },
        "a2": {
          "$ref": "#/$defs/artifactRef"
        },
        "attemptId": {
          "$ref": "#/$defs/safeId"
        },
        "b": {
          "$ref": "#/$defs/artifactRef"
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleSha256",
            "passed",
            "path"
          ],
          "properties": {
            "bundleSha256": {
              "$ref": "#/$defs/sha256"
            },
            "passed": {
              "type": "boolean"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "forks": {
          "enum": [
            10,
            20,
            40
          ]
        },
        "receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleSha256",
        "exit",
        "path",
        "policyOutcome"
      ],
      "properties": {
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "exit": {
          "enum": [
            0,
            6,
            7
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "policyOutcome": {
          "enum": [
            "fail",
            "inconclusive",
            "not-enforced",
            "pass"
          ]
        },
        "policySha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "path",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "hostRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterSha256",
        "comparatorSha256",
        "protocolSha256",
        "rendererSha256",
        "runnerSha256"
      ],
      "properties": {
        "adapterSha256": {
          "$ref": "#/$defs/sha256"
        },
        "comparatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocolSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rendererSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnerSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanupPassed",
        "policySha256",
        "postflight",
        "preflight",
        "restoration",
        "watcher"
      ],
      "properties": {
        "cleanupPassed": {
          "const": true
        },
        "policySha256": {
          "$ref": "#/$defs/sha256"
        },
        "postflight": {
          "$ref": "#/$defs/hostRef"
        },
        "preflight": {
          "$ref": "#/$defs/hostRef"
        },
        "restoration": {
          "$ref": "#/$defs/hostRef"
        },
        "watcher": {
          "$ref": "#/$defs/hostRef"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "files",
        "manifestSha256",
        "role",
        "sequence",
        "settleMillis"
      ],
      "properties": {
        "distribution": {
          "enum": [
            "baseline",
            "candidate"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileFact"
          }
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "A1",
            "A2",
            "B"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "settleMillis": {
          "const": 10000
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
          },
          {
            "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Bb][Ee][Aa][Rr][Ee][Rr])"
          },
          {
            "pattern": "(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|(?:AKIA|ASIA)[0-9A-Z]{16})"
          }
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
