{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revoman.dev/performance/protocol/schemas/adapter-failure-v1.schema.json",
  "title": "ReVoman bootstrap adapter failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapterSha256",
    "failureCode",
    "observedAtUtc",
    "runToken",
    "schemaVersion"
  ],
  "properties": {
    "adapterSha256": {
      "$ref": "#/$defs/sha256"
    },
    "failureCode": {
      "enum": [
        "ADAPTER_MISMATCH",
        "CONTEXT_INVALID",
        "DOCKER_UNAVAILABLE",
        "IMAGE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "LOCK_UNAVAILABLE"
      ]
    },
    "observedAtUtc": {
      "$ref": "#/$defs/timestamp"
    },
    "runToken": {
      "$ref": "#/$defs/safeId"
    },
    "schemaVersion": {
      "const": "adapter-failure-v1"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
          },
          {
            "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Bb][Ee][Aa][Rr][Ee][Rr])"
          },
          {
            "pattern": "(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|(?:AKIA|ASIA)[0-9A-Z]{16})"
          }
        ]
      }
    }
  }
}
