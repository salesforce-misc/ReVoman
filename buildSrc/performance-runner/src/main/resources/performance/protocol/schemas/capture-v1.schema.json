        },
        "policyHash": {
          "$ref": "#/$defs/sha256"
        },
        "postflight": {
          "$ref": "#/$defs/hostDocumentRef"
        },
        "preflight": {
          "$ref": "#/$defs/hostDocumentRef"
        },
        "restoration": {
          "$ref": "#/$defs/hostDocumentRef"
        },
        "watcher": {
          "$ref": "#/$defs/hostDocumentRef"
        }
      }
    },
    "controlledMacBoundedQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignFieldsInapplicableReason",
        "kind",
        "policyHash",
        "postflight",
        "preflight",
        "restoration",
        "watcher"
      ],
      "properties": {
        "campaignFieldsInapplicableReason": {
          "enum": [
            "standaloneBoundedDiagnostic"
          ]
        },
        "kind": {
