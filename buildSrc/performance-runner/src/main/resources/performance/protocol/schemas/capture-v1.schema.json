          "enum": [
            "github-hosted-arm64-canary-v1",
            "m4max-docker-canary-v1",
            "m4max-docker-linux-arm64-v1"
          ]
        },
        "jdk": {
          "$ref": "#/$defs/jdk"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "linux": {
          "$ref": "#/$defs/linux"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "oci": {
          "$ref": "#/$defs/oci"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "substrate": {
          "$ref": "#/$defs/substrate"
        }
      }
    },
    "controlledMacCampaignQualification": {
      "type": "object",
