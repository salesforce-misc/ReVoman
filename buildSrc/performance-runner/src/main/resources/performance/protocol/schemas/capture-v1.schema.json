    "githubHostedSubstrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advertisedResources",
        "dockerEngineVersion",
        "kernel",
        "kind",
        "runnerImageVersion",
        "runnerLabel"
      ],
      "properties": {
        "advertisedResources": {
          "$ref": "#/$defs/resources"
        },
        "dockerEngineVersion": {
          "$ref": "#/$defs/safeText"
        },
        "kernel": {
          "$ref": "#/$defs/safeText"
        },
        "kind": {
          "const": "githubHosted"
        },
        "runnerImageVersion": {
          "$ref": "#/$defs/safeText"
        },
        "runnerLabel": {
          "const": "ubuntu-24.04-arm"
        }
      }
    },
    "substrate": {
      "oneOf": [
        {
          "$ref": "#/$defs/controlledMacSubstrate"
        },
        {
          "$ref": "#/$defs/githubHostedSubstrate"
        }
      ]
    },
    "runtime": {
      "type": "object",
