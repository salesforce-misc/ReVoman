    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "profile"
      ],
      "properties": {
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "enum": [
            "benchmark-noop"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "forks",
        "identity",
        "measurementIterations",
        "profiler",
        "variantSha256",
        "warmupIterations"
      ],
      "properties": {
        "family": {
          "enum": [
            "canary",
            "cold",
            "warm"
          ]
        },
        "forks": {
          "enum": [
            1,
            10,
            20,
            40
          ]
        },
        "identity": {
          "$ref": "#/$defs/safeId"
        },
        "measurementIterations": {
          "type": "integer",
          "minimum": 1
        },
        "profiler": {
          "enum": [
            "none",
            "gc",
            "jfr"
          ]
        },
        "variantSha256": {
          "$ref": "#/$defs/sha256"
        },
        "warmupIterations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "primaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "name"
      ],
      "properties": {
        "direction": {
          "const": "lowerIsBetter"
        },
        "name": {
          "const": "score"
        }
      }
    },
    "jmhResultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonPointer",
        "sha256"
      ],
      "properties": {
        "jsonPointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$",
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sampleDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forks",
        "measurementIterations",
        "samplesPerFork"
      ],
      "properties": {
        "forks": {
          "enum": [
            1,
            10,
            20,
            40
          ]
        },
        "measurementIterations": {
          "type": "integer",
          "minimum": 1
        },
        "samplesPerFork": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "forkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fork",
        "sampleCount",
        "score"
      ],
      "properties": {
        "fork": {
          "type": "integer",
          "minimum": 1
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchSize",
        "benchmark",
        "derivedForkSummaries",
        "jmhResultRow",
        "mode",
        "parameters",
        "primaryMetric",
        "sampleDimensions",
        "threads",
        "unit"
      ],
      "properties": {
        "batchSize": {
          "const": 1
        },
        "benchmark": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$.]*(?:\\.[A-Za-z_][A-Za-z0-9_$]*)+$",
          "maxLength": 512
        },
        "derivedForkSummaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/forkSummary"
          }
        },
        "jmhResultRow": {
          "$ref": "#/$defs/jmhResultRow"
        },
        "mode": {
          "const": "ss"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              },
              {
                "not": {
                  "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss](?:[Ww][Oo][Rr][Dd]|[Ww][Dd])?|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh](?:[Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])?|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt])"
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeText"
          }
        },
        "primaryMetric": {
          "$ref": "#/$defs/primaryMetric"
        },
        "sampleDimensions": {
          "$ref": "#/$defs/sampleDimensions"
        },
        "threads": {
          "const": 1
        },
        "unit": {
          "const": "ms/op"
        }
      }
    },
    "profilerSummaryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawInputSha256",
        "sha256",
        "variantSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rawInputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variantSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
